{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "bash": "ask",
        "read": "allow",
        "webfetch": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "grep": "allow",
        "question": "allow",
        "websearch": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow"
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "enabled": true
        }
    }
}
